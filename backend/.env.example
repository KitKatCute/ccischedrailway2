# Flask secret key for sessions (change in production)
SECRET_KEY=your-secret-key-here

# Database connection string
# For MySQL: mysql+pymysql://user:password@localhost:3306/ccisched_sept10
# For SQLite (dev): sqlite:///ccisched.db
DATABASE_URL=sqlite:///ccisched.db

# Server port (optional, defaults to 5000)
PORT=5000

# Deployed frontend URL(s) allowed to call the API (comma-separated, no trailing slash)
# FRONTEND_ORIGINS=https://your-frontend.up.railway.app

# ── Email (Forgot password -> temporary password). See MAIL_SETUP.md ──
# Option A - Brevo (HTTPS API, recommended on Railway)
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=CCISched
# Option B - SMTP (e.g. Gmail + App Password)  (set A and B together = Brevo first, SMTP backup)
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=   (optional; defaults to MAIL_FROM_EMAIL, then SMTP_USER)
