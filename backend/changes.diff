+def preference_rank(prefs: list[str], course_code: str) -> int:
+    """1-based rank of course_code in an ordered preference list, 0 if absent."""
+    code = str(course_code or "").strip().upper()
+    return prefs.index(code) + 1 if code in prefs else 0
+
+
+def preference_score(prefs: list[str], course_code: str) -> float:
+    """0.0 if the course isn't preferred; otherwise 1.0 for rank 1, decaying
+    by PREF_DECAY per rank down to PREF_FLOOR."""
+    rank = preference_rank(prefs, course_code)
+    if not rank:
+        return 0.0
+    return max(PREF_FLOOR, 1.0 - PREF_DECAY * (rank - 1))
+
